{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": true,
      "path": ".angular/cache"
    }
  },
  "projects": {
    "renderer": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src/renderer",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/renderer",
              "browser": ""
            },
            "index": "src/renderer/index.html",
            "browser": "src/renderer/main.ts",
            "tsConfig": "tsconfig.renderer.json",
            "polyfills": [],
            "assets": [],
            "styles": [],
            "scripts": [],
            "baseHref": "/",
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": {
              "scripts": true,
              "styles": {
                "minify": true,
                "inlineCritical": false
              },
              "fonts": false
            }
          },
          "configurations": {
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          }
        }
      }
    }
  }
}
