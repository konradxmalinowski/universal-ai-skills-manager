{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "allowJs": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.mjs", "*.ts", "*.mjs"]
}
