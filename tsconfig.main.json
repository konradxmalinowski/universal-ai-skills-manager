{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo-main"
  },
  "include": [
    "src/main/**/*.ts",
    "src/core/**/*.ts",
    "src/infra/**/*.ts",
    "src/adapters/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
